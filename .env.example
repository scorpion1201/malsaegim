# 음성 인식 API 는 서버에 두지 않는다 — 각 사용자가 설정 페이지(BYOK)에서 API Base URL·API Key·모델 이름을 저장하면
# 브라우저가 만든 요청을 /api/asr/proxy 가 그 주소로 그대로 넘겨 준다(저장·기록 없음).

# 접근 제어(선택) — APP_SHARED_PASSWORD 가 비어 있으면 로그인 없이 바로 열린다.
# AUTH_COOKIE_SECRET 도 선택(32자 이상 무작위 문자열). 없으면 비밀번호에서 파생한 키로 세션을 서명한다.
APP_SHARED_PASSWORD=
AUTH_COOKIE_SECRET=

# 선택: rhwp wasm 경로를 직접 지정할 때만 (기본 node_modules/@rhwp/core/rhwp_bg.wasm)
# RHWP_WASM_PATH=

# 선택: 공유 링크(Open Graph)에 쓰는 서비스 주소. 빌드 때 고정되며 브라우저에 공개되는 값이다
NEXT_PUBLIC_SITE_URL=

# 선택: API 프록시가 호출할 수 있는 호스트(쉼표 구분, .example.com 은 하위 도메인). 비우면 공개 주소 전체를 허용한다
ASR_PROXY_ALLOWED_HOSTS=